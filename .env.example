# Copy to .env and set both. compose.yml refuses to start without them.
#
# A URL-safe password for PostgreSQL: it is written into a postgres:// URL.
SKEIN_DB_PASSWORD=
# The bucket's secret key; at least 8 characters (MinIO's minimum).
SKEIN_STORE_PASSWORD=
# Where people reach Skein. Behind TLS: https://skein.example.com
SKEIN_PUBLIC_URL=http://localhost:8080
